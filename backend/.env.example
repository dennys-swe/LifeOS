# Obrigatório — string de conexão com o banco PostgreSQL (Neon.tech)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Obrigatório — chave de assinatura dos JWT de autenticação. Gerar com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=<chave secreta aleatória>

# Origens permitidas no CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:5173

# Segredo para autenticar o disparo do job de sync diário via HTTP (Fase 5)
CRON_SECRET=<segredo aleatório>

# Open Finance (Pluggy) — conexão bancária/faturas
PLUGGY_CLIENT_ID=<client id da Pluggy>
PLUGGY_CLIENT_SECRET=<client secret da Pluggy>

# Push notifications (VAPID) — gerar com: venv/bin/python3 scripts/generate_vapid.py
VAPID_PRIVATE_KEY=<chave privada PEM>
VAPID_PUBLIC_KEY=<chave pública base64url>
VAPID_CLAIMS_EMAIL=mailto:dennysalvescontato@gmail.com
