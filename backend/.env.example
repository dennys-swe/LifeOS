# ─────────────────────────────────────────────────────────────────────────────
# DESENVOLVIMENTO LOCAL
# ─────────────────────────────────────────────────────────────────────────────
# Copie para backend/.env. Este arquivo é a configuração de DEV: nunca aponte
# o DATABASE_URL local para o banco de produção (Neon). O backend recusa subir
# nesse caso — veja o guard em app/db/database.py.

# Banco de dev = Postgres do docker-compose (na raiz do repo).
#   docker compose up -d db && cd backend && ./scripts/dev_bootstrap.sh
# `sslmode=disable` é obrigatório: o container local não tem TLS.
DATABASE_URL=postgresql+psycopg2://lifeos:lifeos@localhost:5432/lifeos_dev?sslmode=disable

# development | staging | production. Dirige o guard de banco e o environment
# do Sentry. Em produção o Render seta ENVIRONMENT=production.
ENVIRONMENT=development

# Chave de assinatura dos JWT. Gerar: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=<chave secreta aleatória>

# Origens permitidas no CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:5173

# Segredo do disparo do job de sync diário via HTTP (POST /jobs/daily-sync)
CRON_SECRET=<segredo aleatório>

# Observabilidade (opcional). Sem SENTRY_DSN o Sentry fica desligado — dev e CI
# não precisam de conta. O environment reportado ao Sentry vem de ENVIRONMENT.
# SENTRY_DSN=https://xxxx@oyyyy.ingest.sentry.io/zzzz
# LOG_LEVEL=INFO

# Open Finance (Pluggy) — conexão bancária/faturas.
# Uso pessoal: criar uma Development Application em dashboard.pluggy.ai e habilitar
# o conector "MeuPluggy" (os bancos são conectados em meu.pluggy.ai). Trial expirado
# do dashboard NÃO bloqueia a API. Ver seção "Uso pessoal" no CLAUDE.md.
PLUGGY_CLIENT_ID=<client id da Pluggy>
PLUGGY_CLIENT_SECRET=<client secret da Pluggy>

# Push notifications (VAPID) — gerar com: venv/bin/python3 scripts/generate_vapid.py
VAPID_PRIVATE_KEY=<chave privada PEM>
VAPID_PUBLIC_KEY=<chave pública base64url>
VAPID_CLAIMS_EMAIL=mailto:example@example.com

# ─────────────────────────────────────────────────────────────────────────────
# PRODUÇÃO (referência — configurado nas env vars do Render, não neste arquivo)
# ─────────────────────────────────────────────────────────────────────────────
#   DATABASE_URL=postgresql://<user>:<pwd>@<...>.neon.tech/<db>?sslmode=require
#   ENVIRONMENT=production
#   SENTRY_DSN=<dsn real>
#
# Para ler o banco de produção pontualmente a partir da máquina local, sem
# deixar a URL de prod no .env: exporte ALLOW_PROD_DB=1 e o DATABASE_URL de prod
# só naquela sessão de shell.
